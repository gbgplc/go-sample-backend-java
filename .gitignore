target/
*.class
.idea/
*.iml
.vscode/
.mvn/wrapper/maven-wrapper.jar

# Local-only: JDK unzipped into the project folder, not project code
oracleJdk-26.jdk/
.DS_Store

# Credentials. application-*.yml reads these from the environment precisely so
# they never land in a tracked file — keep it that way. .env.example is the
# exception: it lists the variable names with no values, and is committed so
# a new checkout knows what to fill in.
.env
.env.*
!.env.example

# sdk-implementation/docs/sdk-jar-inspection: downloaded/decompiled SDK jars —
# large, derived, and not worth committing. pom.xml and FINDINGS.md (the
# actual conclusions) are tracked.
sdk-implementation/docs/**/libs/
sdk-implementation/docs/**/extracted/
sdk-implementation/docs/**/decompiled/
