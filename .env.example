# Copy to .env.local and fill in. Required for go.mode=live; ignored in mock
# mode. ./run.sh sources it automatically.
#
# .env.local is gitignored. Never commit real values — not here, not in the
# application-*.yml files, not in a test or a scratch script.

# From the Account management portal, or whoever administers the tenant.
GBG_CLIENT_ID=
GBG_CLIENT_SECRET=

# Password grant only (the nonprod fabric tenants). Leave blank for the public
# platform, which uses client_credentials — see go.grant-type in
# application-<market>.yml.
GBG_USERNAME=
GBG_PASSWORD=
